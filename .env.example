# Generic OpenAI-compatible provider (recommended for custom endpoints)
# LLM_API_KEY=
# LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=grok-4.5

# API wire format: Chat Completions by default; "responses" for the OpenAI Responses API,
# or "anthropic_messages" for the native Anthropic Messages API
# LLM_API_FORMAT=chat_completions
# Optional model override for per-chapter notes on long transcripts (defaults to LLM_MODEL)
# LLM_NOTES_MODEL=
# Per-request LLM timeout in seconds (default: 300)
# LLM_TIMEOUT=300

# Whisper weights default to models/faster-whisper inside this project.
# WHISPER_MODEL_DIR=models/faster-whisper

# Fast HTTP downloads reject private/loopback/link-local targets by default.
# Enable only for a trusted local media server.
# VIDEOMEMO_ALLOW_PRIVATE_URLS=1

# Official xAI fallback when no custom URL or local Grok CLI config is present
# XAI_API_KEY=
